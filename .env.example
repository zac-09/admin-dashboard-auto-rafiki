# Copy to `.env.local` (git-ignored). VITE_* vars are inlined into the bundle: never put
# secrets here. The Firebase web config is public by design; access is enforced by rules.

# "true" (default) = mock repositories and fixtures, no Firebase needed.
# "false" = real Firebase (the emulator in dev, see VITE_USE_EMULATORS).
VITE_USE_MOCKS=true

# With mocks off: "true" (default in dev) points Auth/Firestore/Functions at the local
# emulator suite. Never point a dev build at production with write-capable scripts.
VITE_USE_EMULATORS=true

# Firebase web app config (Console → Project settings → Your apps → Web app). Isaac supplies.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=auto-rafiki.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=auto-rafiki
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# Cloud Functions region for the dashboard's callables.
VITE_FUNCTIONS_REGION=europe-west1

# Maps JavaScript API key for the live ops map (module 2). Its own key, restricted by HTTP
# referrer (Hosting domain + localhost) and to the Maps JavaScript API. Not the app's keys.
VITE_MAPS_API_KEY=
